# ================================================================
# KONFIGURASI DAILY TECH DIGEST BOT
# ================================================================

# [WAJIB] Token Bot Telegram (bisa pakai bot yang sama dari @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# [WAJIB] ID Chat Telegram pribadi Anda (dapatkan dari @userinfobot di Telegram)
TELEGRAM_CHAT_ID=your_chat_id_here

# [OPSIONAL] Jadwal pengiriman otomatis setiap pagi (format 24 jam HH:MM)
DIGEST_TIME=07:00

# [OPSIONAL] Jumlah artikel maksimal per sumber berita (default: 3)
MAX_ARTICLES_PER_FEED=3

# [OPSIONAL] Lokasi database deduplikasi lokal
DATABASE_PATH=digest.db

# [OPSIONAL] Kunci API Google Gemini jika ingin ringkasan berbasis AI
# Jika dikosongkan, bot otomatis menggunakan parser ekstraktif lokal tanpa biaya
GEMINI_API_KEY=
